# NeMo RL on Rhea (Vera Rubin): exploration of training Nemotron 3.5 Lightning 30B with NeMo RL instead of rhea/rlvr.py.
# Builds on ../nemotron/nemotron.env (model, cricket data, NeMo Gym environment, Lustre layout, secrets).
source "${CODE_DIR:-/home/bbalakreshna/clustercodes}/nemotron/nemotron.env"

NRL_CODE=$CODE_DIR/nemorl
NRL_ROOT=$LUSTRE_DIR/nemo-rl                      # everything for this exploration lives here, on Lustre
NRL_REPO=$NRL_ROOT/RL                             # git clone of github.com/NVIDIA-NeMo/RL with submodules
NRL_REF=${NRL_REF:-main}
NRL_VENVS=$NRL_ROOT/venvs                         # uv environments (driver and per-worker)
NRL_LOGS=$LOG_DIR/nemo-rl
export UV_PYTHON_INSTALL_DIR=$LUSTRE_DIR/cache/uv-python UV_CACHE_DIR=$LUSTRE_DIR/cache/uv
export NEMO_RL_VENV_DIR=$NRL_VENVS/workers
