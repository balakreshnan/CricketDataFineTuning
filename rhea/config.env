# Cricket reasoning LoRA on Rhea. Sourced by submit.sh and every job. Everything big is on Lustre.
source "${CODE_DIR:-/home/bbalakreshna/clustercodes}/env.sh"

ACCOUNT=${ACCOUNT:-general_sa}
PARTITION=${PARTITION:-batch,backfill}  # batch 5 h (no preemption); backfill 8 h, preemptible with 600 s grace. Job starts where it fits first
GPUS_PER_NODE=${GPUS_PER_NODE:-4}       # 4x Vera Rubin (VR NVL72, 286 GB) per node; aarch64 Vera, whole-node allocation, no GRES
RUN_FROM=${RUN_FROM:-$HOME}

MODEL_ID=Qwen/Qwen3.8-27B
DATASET_ID=Balab2021/CricketData-T20-Reasoning-Qwen3.8-Full
PROJ=$LUSTRE_DIR/cricket-rhea
MODEL_DIR=$MODELS_DIR/Qwen3.8-27B
DATA_LOCAL=$DATA_DIR/CricketData-T20-Reasoning-Qwen3.8-Full
VENV=$VENV_DIR/qwen38-lora
SLURM_LOGS=$LOG_DIR/cricket-rhea

# Rubin PyTorch container (same image family that worked on Hecate); imported to Lustre by setup.sbatch
IMAGE_REMOTE=gitlab-master.nvidia.com/dl/dgx/pytorch:main-py3-devel
IMAGE_SQSH=$CONTAINER_DIR/pytorch-main-py3-devel-arm64.sqsh

# HF_TOKEN, WANDB_API_KEY (+ optional WANDB_ENTITY). Created by bin/set-secrets, chmod 600.
SECRETS_FILE=${SECRETS_FILE:-$LUSTRE_DIR/secrets.env}
WANDB_PROJECT=qwen38-cricket-reasoning-rhea
HF_MODEL_REPO=${HF_MODEL_REPO:-Balab2021/Qwen3.8-27B-Cricket-Reasoning-Rhea-LoRA}

# RLVR run (rlvr.py): separate W&B project and HF repo
RLVR_WANDB_PROJECT=qwen38-cricket-rlvr-rhea
RLVR_HF_REPO=${RLVR_HF_REPO:-Balab2021/Qwen3.8-27B-Cricket-Reasoning-RLVR}
