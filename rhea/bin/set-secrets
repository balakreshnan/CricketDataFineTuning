#!/usr/bin/env bash
# Set your Hugging Face token and W&B key for Rhea. Run it in YOUR terminal (keys are typed hidden, never echoed
# and never seen by Claude):
#   & 'C:\Program Files\Git\bin\bash.exe' rhea/bin/set-secrets
# It writes $LUSTRE_DIR/secrets.env (chmod 600) on Rhea through the open rhea-bridge session. Job scripts source it.
# Press Enter to keep an existing value. W&B entity is optional.
set -euo pipefail
cd "$(dirname "$0")/.."
[[ -f site.conf ]] && source site.conf
LUSTRE=${LUSTRE:-/lustre/fsw/general_sa/bbalakreshna}
read -r -s -p "Hugging Face token (hf_..., needs write access to push): " HF; echo
read -r -s -p "Weights & Biases API key: " WB; echo
read -r -p "W&B entity/team (optional): " WE
[[ -n "$HF$WB" ]] || { echo "nothing entered"; exit 1; }
payload=$(printf 'HF_TOKEN=%s\nWANDB_API_KEY=%s\nWANDB_ENTITY=%s\n' "$HF" "$WB" "$WE" | base64 -w0)
bin/rx "mkdir -p $LUSTRE && f=$LUSTRE/secrets.env && touch \$f && chmod 600 \$f && old=\$(cat \$f) && \
 new=\$(echo $payload | base64 -d) && \
 get() { echo \"\$new\" | sed -n \"s/^\$1=//p\"; } && getold() { echo \"\$old\" | sed -n \"s/^\$1=//p\"; } && \
 { for k in HF_TOKEN WANDB_API_KEY WANDB_ENTITY; do v=\$(get \$k); [ -z \"\$v\" ] && v=\$(getold \$k); [ -n \"\$v\" ] && echo \"\$k=\$v\"; done; } > \$f.tmp && \
 chmod 600 \$f.tmp && mv \$f.tmp \$f && echo saved keys: \$(cut -d= -f1 \$f | tr '\n' ' ')"
# scrub the typed values from the local command queue
: > "$HOME/.rhea-bridge/cmd" 2>/dev/null || true
unset HF WB WE payload
