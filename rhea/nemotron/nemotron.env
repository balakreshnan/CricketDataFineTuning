# Nemotron 3.5 Lightning 30B on Rhea: RLVR LoRA fine-tune on the cricket dataset, evaluation with NeMo Gym.
# Sourced by nemotron/submit.sh and the nemotron jobs. Builds on ../config.env (dataset, Lustre layout, secrets).
source "${CODE_DIR:-/home/bbalakreshna/clustercodes}/config.env"

NT_CODE=$CODE_DIR/nemotron
NT_DIR=$LUSTRE_DIR/nemotron-rhea                      # runs, eval outputs: $NT_DIR/<run-name>/ on Lustre
NT_LOGS=$LOG_DIR/nemotron-rhea

MODEL_ID=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-BF16
MODEL_DIR=$MODELS_DIR/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-BF16

# Container images for Vera Rubin (aarch64, GPU arch sm_107). See README.md "Images".
#   training / RLVR : $IMAGE_SQSH from ../config.env (dl/dgx/pytorch:main-py3-devel, proven on Rhea)
#   serving for eval: the Rubin build of vLLM. The public NGC vLLM and Dynamo/SGLang images do not run on Rubin.
VLLM_IMAGE_REMOTE=gitlab-master.nvidia.com/dl/dgx/vllm:rubin-py3-devel
VLLM_SQSH=$CONTAINER_DIR/vllm-rubin-py3-devel-arm64.sqsh
GYM_VERSION=0.7.0                                     # pip package nemo-gym, installed into $GYM_VENV
GYM_VENV=$VENV_DIR/nemo-gym

NT_WANDB_PROJECT=${NT_WANDB_PROJECT:-nemotron35-cricket-rlvr-rhea}
NT_HF_REPO=${NT_HF_REPO:-Balab2021/Nemotron-3.5-Lightning-30B-A3B-Cricket-RLVR-Rhea}   # private adapter repo
