# Speculative decoding on Rhea: a small draft model proposes tokens, the big target model verifies them.
# Sourced by specdec/submit.sh and the specdec jobs. Builds on ../config.env (same dataset, Lustre layout, secrets).
source "${CODE_DIR:-/home/bbalakreshna/clustercodes}/config.env"

SD_CODE=$CODE_DIR/specdec
SD_DIR=$PROJ/specdec                         # every run's records and summary: $SD_DIR/<run-name>/ on Lustre

# Draft candidates: same tokenizer and vocabulary (248,320) as the Qwen3.8-27B / Qwen3.6-35B-A3B targets.
# Downloaded to $MODELS_DIR/<name> on Lustre by `submit.sh drafts`.
DRAFT_IDS=${DRAFT_IDS:-"Qwen/Qwen3.5-0.8B Qwen/Qwen3.5-2B Qwen/Qwen3.5-4B Qwen/Qwen3.5-9B"}
DRAFTS=${DRAFTS:-"Qwen3.5-0.8B Qwen3.5-2B Qwen3.5-4B Qwen3.5-9B"}   # which ones a benchmark run compares

# Target = $MODEL_DIR (PROFILE picks it, as for RLVR) plus this LoRA adapter merged in. Empty = base model.
if [[ $PROFILE == qwen36 ]]; then _sd_adapter=$PROJ/runs/qwen36-rlvr-1113/adapter; else _sd_adapter=$PROJ/runs/cricket-rlvr-1114/adapter; fi
TARGET_ADAPTER=${TARGET_ADAPTER-$_sd_adapter}

SD_WANDB_PROJECT=${SD_WANDB_PROJECT:-cricket-specdec-rhea}
SD_HF_REPO=${SD_HF_REPO:-Balab2021/Cricket-SpecDec-Rhea}            # private dataset repo: results, records, card
