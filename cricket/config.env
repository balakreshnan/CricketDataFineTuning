# Cricket reasoning project settings. Sourced by submit.sh on the login node and exported into every job.
# Everything this project writes lives under CROOT (Lustre), separate from the FinNews experiments; it only
# shares the container image, the Python env and the cached Qwen3.8-27B weights.

ACCOUNT=general_sa
PARTITION=${PARTITION:-batch-xdr}   # comma list allowed, e.g. PARTITION=batch-xdr,batch-spx (job starts where it fits first)
RUN_FROM=/home/bbalakreshna

LUSTRE_DIR=${LUSTRE_DIR:-/lustre/fsw/$ACCOUNT/$USER}
LUSTRE_REAL=$(readlink -f "$LUSTRE_DIR")
CROOT=$LUSTRE_REAL/clustercodes/cricket          # data/, runs/, checkpoints/, logs/
CODE_DIR=$LUSTRE_REAL/clustercodes/code/cricket  # this folder, synced by bin/hsync
DATA_DIR=$CROOT/data

# shared with the FinNews project
VENV=$LUSTRE_REAL/clustercodes/venv/qwen38-ft
IMAGE_REMOTE=gitlab-master.nvidia.com/dl/dgx/pytorch:main-py3-devel
IMAGE_SQSH=$LUSTRE_REAL/clustercodes/containers/pytorch-main-py3-devel.sqsh
HF_HOME=$LUSTRE_REAL/hf_cache
MODEL_ID=Qwen/Qwen3.8-27B
MODEL_REVISION=1d4bf0f2ff6012fd82039f2fa52739d0dd7c60c0
MODEL_DIR=$HF_HOME/hub/models--Qwen--Qwen3.8-27B/snapshots/$MODEL_REVISION
PIP_CACHE_DIR=$LUSTRE_REAL/clustercodes/cache/pip
XDG_CACHE_HOME=$LUSTRE_REAL/clustercodes/cache
TRITON_CACHE_DIR=$LUSTRE_REAL/clustercodes/cache/triton

SECRETS_FILE=${SECRETS_FILE:-$LUSTRE_REAL/qwen38-gsm8k/secrets.env}   # HF_TOKEN, WANDB_API_KEY, WANDB_ENTITY
WANDB_PROJECT=qwen38-cricket-reasoning
HF_DATASET_REPO=${HF_DATASET_REPO:-Balab2021/CricketData-T20-Reasoning-Qwen3.8}
HF_MODEL_REPO=${HF_MODEL_REPO:-Balab2021/Qwen3.8-27B-Cricket-Reasoning-LoRA}

# NGC vLLM image for generation + evals (one engine per GPU); imported once by `submit.sh import-vllm`
VLLM_IMAGE_REMOTE=gitlab-master.nvidia.com/dl/dgx/vllm:rubin-py3-devel   # Rubin (sm_107) build; NGC vllm:26.08 Triton cannot target sm_107
VLLM_SQSH=$LUSTRE_REAL/clustercodes/containers/vllm-rubin-py3-devel.sqsh
