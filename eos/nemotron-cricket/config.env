# Nemotron-3.5-Lightning cricket SFT on EOS (H100). Sourced by submit.sh and exported into every job.
# Code runs from $HOME/clustercodes/nemotron-cricket; everything large lives on Lustre (see ../env.sh).
source "$HOME/clustercodes/env.sh"

ACCOUNT=general_sa
PARTITION=${PARTITION:-batch}
RUN_FROM=$HOME
CODE_DIR=$CODE_DIR/nemotron-cricket
PROJ=$LUSTRE_DIR/nemotron-cricket                # data/, runs/, ckpts/, logs/
SLURM_LOGS=$LOG_DIR/nemotron-cricket

IMAGE_REMOTE=nvcr.io#nvidia/nemo:26.08.01
IMAGE_SQSH=$CONTAINER_DIR/nemo-26.08.01.sqsh

MODEL_ID=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-BF16
MODEL_REVISION=a9904d24bcc1d289a1950fa9d2b978c47cf903b9
DATASET_ID=Balab2021/CricketData-T20-Reasoning-Qwen3.8-Full
DATASET_REVISION=ad669766ef046c8ccc5330d077c77118b692ec00

# HF_TOKEN (write access), WANDB_API_KEY, WANDB_ENTITY - created by the user, chmod 600
SECRETS_FILE=${SECRETS_FILE:-$LUSTRE_DIR/secrets.env}
WANDB_PROJECT=nemotron35-cricket-reasoning
HF_MODEL_REPO=${HF_MODEL_REPO:-Balab2021/Nemotron-3.5-Lightning-30B-A3B-Cricket-Reasoning}
