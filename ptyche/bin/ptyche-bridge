#!/usr/bin/env bash
# Open ONE MFA-authenticated SSH session to Ptyche and execute the commands ptyche/bin/px queues through it.
# Start it from PowerShell, finish the MFA prompt, then leave the window open (Ctrl-C to close):
#   & 'C:\Program Files\Git\bin\bash.exe' ptyche/bin/ptyche-bridge
set -u
Q="$HOME/.ptyche-bridge"
mkdir -p "$Q"
# Only one bridge at a time: a second one would wipe the queue and execute every command twice.
if [[ -f "$Q/pid" ]] && kill -0 "$(cat "$Q/pid")" 2>/dev/null && [[ "$(cat "$Q/state" 2>/dev/null)" == open ]]; then
  echo "An Ptyche bridge is already running (pid $(cat "$Q/pid")). Use that window, or close it first."
  exit 1
fi
echo $$ > "$Q/pid"
: > "$Q/cmd"
: > "$Q/out"
echo "open" > "$Q/state"

exec 3< <(tail -n0 -f "$Q/cmd")
TAIL_PID=$!
( until grep -q __HX_BRIDGE_UP__ "$Q/out" 2>/dev/null; do sleep 1; done
  echo "Connected. Claude can now run commands on Ptyche via ptyche/bin/px. Keep this window open." ) &

echo "Connecting to Ptyche - complete the MFA prompt below."
# Remote side: a plain bash reading one command per line from the queue; output goes to $Q/out.
/usr/bin/ssh -F "$(dirname "$0")/../ssh_config" ptyche 'echo __HX_BRIDGE_UP__; exec bash -s 2>&1' <&3 >> "$Q/out"
rc=$?
echo "closed" > "$Q/state"
kill "$TAIL_PID" 2>/dev/null
echo "Ptyche session ended (ssh exit $rc). Re-run ptyche/bin/ptyche-bridge to reconnect."
