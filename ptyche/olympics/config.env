# Olympics reasoning: Dynamo (SGLang backend) hosts Nemotron-3.5-Lightning generates reasoning traces, then full SFT of the same model.
# Sourced by every script/job. Code runs from /home/bbalakreshna/clustercodes/olympics; everything large on Lustre.
source /home/bbalakreshna/clustercodes/env.sh

ACCOUNT=general_sa
PARTITION=${PARTITION:-batch}
RUN_FROM=/home/bbalakreshna
CODE_DIR=/home/bbalakreshna/clustercodes/olympics
PROJ=$LUSTRE_DIR/olympics                        # data/, gen/, ckpts/, runs/
SLURM_LOGS=$LOG_DIR/olympics
GPUS_PER_NODE=4                                  # GB200 NVL72 trays: 4 GPUs + 2 Grace (aarch64) per node

DYNAMO_IMAGE_REMOTE=nvcr.io#nvidia/ai-dynamo/sglang-runtime:1.5.1   # Dynamo with the SGLang backend (user choice)
DYNAMO_SQSH=$CONTAINER_DIR/dynamo-sglang-runtime-1.5.1-arm64.sqsh
NEMO_IMAGE_REMOTE=nvcr.io#nvidia/nemo:26.08.01
NEMO_SQSH=$CONTAINER_DIR/nemo-26.08.01-arm64.sqsh

MODEL_ID=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-BF16
MODEL_REVISION=a9904d24bcc1d289a1950fa9d2b978c47cf903b9
DATASET_ID=pranjalvoid/olympics-dataset
DATASET_REVISION=6b64cefd9bd3566e2a800157643d8e4074dbac85
RAW_DIR=$DATA_DIR/olympics-dataset              # athlete_events.csv, noc_regions.csv

TOOLS_VENV=$LUSTRE_DIR/venvs/login-tools         # x86_64 venv for login-node data prep (pandas, hf hub)

# HF_TOKEN (write), optional WANDB_ENTITY - chmod 600. W&B key also comes from ~/.netrc.
SECRETS_FILE=${SECRETS_FILE:-$LUSTRE_DIR/secrets.env}
WANDB_PROJECT=nemotron35-olympics-reasoning
HF_DATASET_REPO=${HF_DATASET_REPO:-Balab2021/Olympics-Reasoning-Nemotron-3.5-Lightning}     # 1:1 distilled dataset (public)
HF_MODEL_REPO=${HF_MODEL_REPO:-Balab2021/Nemotron-3.5-Lightning-30B-A3B-Olympics-Reasoning}  # fine-tuned weights (private)
